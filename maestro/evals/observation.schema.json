{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/eval-observation.schema.json",
  "title": "Maestro Agent Behavior Eval Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "task_created", "implementation_started", "mode", "read_only",
    "temporary", "workers", "execution", "memory", "handoff", "authorization",
    "user_questions", "files_modified", "actions", "judgments"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "task_created": { "type": "boolean" },
    "implementation_started": { "type": "boolean" },
    "mode": {
      "enum": ["one-off", "investigation", "execution", "waiting-for-authorization", "handoff"]
    },
    "read_only": { "type": "boolean" },
    "temporary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "id", "source_preserved"],
      "properties": {
        "action": { "enum": ["none", "create", "resume", "promote", "archive"] },
        "id": { "type": ["string", "null"] },
        "source_preserved": { "type": ["boolean", "null"] }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "lifecycle", "permissions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["role", "reusable", "composed", "generated"] },
          "lifecycle": { "enum": ["session", "temporary", "task", "permanent"] },
          "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_agent", "worker_runs"],
      "properties": {
        "main_agent": { "enum": ["idle", "waiting", "resumed", "completed", "interrupted"] },
        "worker_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "awaited", "result_consumed"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["queued", "running", "completed", "blocked", "failed", "interrupted"] },
              "awaited": { "type": "boolean" },
              "result_consumed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_temporary", "routing_basis", "evidence_precedence"],
      "properties": {
        "selected_temporary": { "type": ["string", "null"] },
        "routing_basis": { "type": ["string", "null"] },
        "evidence_precedence": { "type": ["string", "null"] },
        "manifest_loaded": { "type": "boolean" },
        "retrieved_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "detail_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "retrieval_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "status", "needs_user_input", "questions", "full_history_reloaded"],
      "properties": {
        "created": { "type": "boolean" },
        "status": { "enum": ["none", "completed", "blocked", "partial"] },
        "needs_user_input": { "type": "boolean" },
        "questions": { "type": "array", "items": { "type": "string" } },
        "full_history_reloaded": { "type": "boolean" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "actions"],
      "properties": {
        "requested": { "type": "boolean" },
        "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "references_loaded": {
      "type": "array",
      "description": "Reference paths opened for the current decision, relative to the Skill root. Installing the Skill bundle does not count as loading a Reference.",
      "items": { "type": "string", "pattern": "^references/.+\\.md$" },
      "uniqueItems": true
    },
    "user_questions": { "type": "array", "items": { "type": "string" } },
    "files_modified": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
