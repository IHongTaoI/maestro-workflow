{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/eval-observation-set.schema.json",
  "title": "Maestro Eval Observation Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": { "const": 1 },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "task_created", "implementation_started", "mode", "read_only",
        "temporary", "workers", "memory", "handoff", "authorization", "user_questions",
        "files_modified", "actions"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "task_created": { "type": "boolean" },
        "implementation_started": { "type": "boolean" },
        "mode": {
          "enum": ["one-off", "investigation", "execution", "waiting-for-authorization", "handoff"]
        },
        "read_only": { "type": "boolean" },
        "temporary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "enum": ["none", "create", "resume", "promote", "archive"] },
            "id": { "type": "string" },
            "source_preserved": { "type": "boolean" }
          }
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "lifecycle", "permissions"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["role", "reusable", "composed", "generated"] },
              "lifecycle": { "enum": ["session", "temporary", "task", "permanent"] },
              "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selected_temporary": { "type": ["string", "null"] },
            "routing_basis": { "type": ["string", "null"] },
            "evidence_precedence": { "type": ["string", "null"] }
          }
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["created", "needs_user_input", "questions", "full_history_reloaded"],
          "properties": {
            "created": { "type": "boolean" },
            "status": { "enum": ["none", "completed", "blocked", "partial"] },
            "needs_user_input": { "type": "boolean" },
            "questions": { "type": "array", "items": { "type": "string" } },
            "full_history_reloaded": { "type": "boolean" }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "actions"],
          "properties": {
            "requested": { "type": "boolean" },
            "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "user_questions": { "type": "array", "items": { "type": "string" } },
        "files_modified": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "judgments": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "rationale"],
            "properties": {
              "passed": { "type": "boolean" },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
