{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/eval-case.schema.json",
  "title": "Maestro Agent Behavior Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "category", "regression", "setup", "turns", "expect", "must_not"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["work-shape", "routing", "memory", "handoff", "authorization"]
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real_case", "source"],
      "properties": {
        "real_case": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "setup": { "type": "object" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_prompt"],
        "properties": {
          "user_prompt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expect": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "must_not": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    },
    "llm_judges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rubric"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "rubric": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "value"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)+$" },
        "operator": {
          "enum": ["equals", "contains", "length_equals", "length_lte", "exists"]
        },
        "value": {}
      }
    }
  }
}
