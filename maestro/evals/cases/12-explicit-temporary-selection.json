{
  "schema_version": 1,
  "id": "explicit-temporary-id-wins-routing",
  "name": "Explicit Temporary ID overrides recency and Session binding",
  "category": "memory",
  "regression": { "real_case": true, "source": "temporary-routing.md explicit reference scenario" },
  "setup": {
    "active_temporaries": [
      { "id": "temp-login", "topic": "login performance", "updated_at": "2026-08-30T09:00:00Z" },
      { "id": "temp-billing", "topic": "billing retry", "updated_at": "2026-08-29T09:00:00Z" }
    ],
    "session_binding": "temp-login"
  },
  "turns": [{ "user_prompt": "继续 temp-billing，验证重试上限" }],
  "expect": [
    { "path": "/memory/selected_temporary", "operator": "equals", "value": "temp-billing" },
    { "path": "/memory/routing_basis", "operator": "equals", "value": "explicit-id" }
  ],
  "must_not": [
    { "path": "/memory/selected_temporary", "operator": "equals", "value": "temp-login" }
  ]
}
