{
  "schema_version": 1,
  "id": "memory-query-loads-only-memory-reference",
  "name": "Memory query loads only the Memory reference",
  "category": "memory",
  "regression": { "real_case": true, "source": "Issue #29: Memory work eagerly loaded unrelated references" },
  "setup": {
    "memory_index": [
      { "id": "lt-performance", "summary": "Homepage startup investigation", "tags": ["performance"] },
      { "id": "lt-naming", "summary": "Product naming conventions", "tags": ["naming"] }
    ]
  },
  "turns": [{ "user_prompt": "只查一下项目里和首页性能有关的长期记忆，不要修改任何状态。" }],
  "expect": [
    { "path": "/references_loaded", "operator": "equals", "value": ["references/memory.md"] },
    { "path": "/memory/retrieved_ids", "operator": "contains", "value": "lt-performance" },
    { "path": "/read_only", "operator": "equals", "value": true }
  ],
  "must_not": [
    { "path": "/memory/retrieved_ids", "operator": "contains", "value": "lt-naming" },
    { "path": "/references_loaded", "operator": "contains", "value": "references/storage.md" },
    { "path": "/references_loaded", "operator": "contains", "value": "references/coordination.md" }
  ]
}
