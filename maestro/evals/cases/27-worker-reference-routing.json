{
  "schema_version": 1,
  "id": "worker-delegation-loads-worker-and-coordination",
  "name": "Capability Worker delegation loads Worker and Coordination references",
  "category": "routing",
  "regression": { "real_case": true, "source": "Issue #29: Worker delegation had no minimal Reference set" },
  "setup": { "available_workers": [] },
  "turns": [{ "user_prompt": "委派一个一次性的只读 Worker 检查 API 超时调用链，不保存状态，当前 Session 完成后失效。" }],
  "expect": [
    { "path": "/references_loaded", "operator": "equals", "value": ["references/coordination.md", "references/workers.md"] },
    { "path": "/workers/0/kind", "operator": "equals", "value": "generated" },
    { "path": "/workers/0/lifecycle", "operator": "equals", "value": "session" }
  ],
  "must_not": [
    { "path": "/references_loaded", "operator": "contains", "value": "references/storage.md" },
    { "path": "/actions", "operator": "contains", "value": "publish-generated-worker" }
  ]
}
