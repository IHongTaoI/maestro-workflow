{
  "schema_version": 1,
  "id": "generated-worker-follows-temporary-lifecycle",
  "name": "Generated exploratory Worker stays bounded to its Temporary",
  "category": "routing",
  "regression": { "real_case": false, "source": "capability-workers.md generated Temporary-scoped Worker" },
  "setup": {
    "active_temporaries": [{ "id": "temp-profiling", "topic": "GPU profiling" }],
    "session_binding": "temp-profiling",
    "reusable_worker_match": false
  },
  "turns": [{ "user_prompt": "继续做只读 GPU profile，需要的话生成一个临时 Worker" }],
  "expect": [
    { "path": "/workers/0/kind", "operator": "equals", "value": "generated" },
    { "path": "/workers/0/lifecycle", "operator": "equals", "value": "temporary" },
    { "path": "/task_created", "operator": "equals", "value": false }
  ],
  "must_not": [
    { "path": "/workers/0/lifecycle", "operator": "equals", "value": "permanent" },
    { "path": "/actions", "operator": "contains", "value": "publish-generated-worker" }
  ]
}
