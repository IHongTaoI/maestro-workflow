{
  "schema_version": 1,
  "id": "core-waiting-needs-no-reference",
  "name": "Core waiting invariant applies before Reference loading",
  "category": "routing",
  "regression": { "real_case": true, "source": "Issue #29: Progressive Disclosure must not hide Worker waiting" },
  "setup": {
    "execution_state": {
      "main_agent": "resumed-by-goal-loop",
      "worker_runs": [{ "id": "trace-worker", "status": "running", "result_available": false }]
    }
  },
  "turns": [{ "user_prompt": "继续完成当前目标。" }],
  "expect": [
    { "path": "/references_loaded", "operator": "length_equals", "value": 0 },
    { "path": "/execution/main_agent", "operator": "equals", "value": "waiting" },
    { "path": "/execution/worker_runs/0/awaited", "operator": "equals", "value": true }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "take-over-running-worker" },
    { "path": "/actions", "operator": "contains", "value": "interrupt-running-worker" }
  ]
}
