{
  "schema_version": 1,
  "id": "memory-overview-uses-manifest",
  "name": "Memory overview loads the Manifest without opening details",
  "category": "memory",
  "regression": { "real_case": true, "source": "Issue #27: Agent had no project Memory overview" },
  "setup": {
    "memory_manifest": [
      { "id": "temp-home", "summary": "Homepage startup investigation" },
      { "id": "lt-performance", "summary": "Collect runtime evidence before optimization" }
    ]
  },
  "turns": [{ "user_prompt": "当前有哪些记忆？" }],
  "expect": [
    { "path": "/memory/manifest_loaded", "operator": "equals", "value": true },
    { "path": "/memory/detail_ids", "operator": "length_equals", "value": 0 },
    { "path": "/actions", "operator": "contains", "value": "present-memory-map" }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "load-all-memory-details" },
    { "path": "/handoff/full_history_reloaded", "operator": "equals", "value": true }
  ]
}
