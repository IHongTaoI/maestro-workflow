{
  "schema_version": 1,
  "id": "progressive-memory-retrieval",
  "name": "Only relevant Memory detail enters context",
  "category": "memory",
  "regression": { "real_case": true, "source": "Issue #27: all Long-term Memory was loaded together" },
  "setup": {
    "memory_index": [
      { "id": "lt-performance", "summary": "Collect a trace before startup optimization", "tags": ["performance", "trace"] },
      { "id": "lt-naming", "summary": "Product naming preferences", "tags": ["naming"] }
    ]
  },
  "turns": [{ "user_prompt": "分析首页启动性能，先看看之前有没有相关经验。" }],
  "expect": [
    { "path": "/memory/manifest_loaded", "operator": "equals", "value": true },
    { "path": "/memory/retrieved_ids", "operator": "contains", "value": "lt-performance" },
    { "path": "/memory/detail_ids", "operator": "contains", "value": "lt-performance" },
    { "path": "/memory/retrieval_reasons", "operator": "length_equals", "value": 1 }
  ],
  "must_not": [
    { "path": "/memory/retrieved_ids", "operator": "contains", "value": "lt-naming" },
    { "path": "/memory/detail_ids", "operator": "contains", "value": "lt-naming" },
    { "path": "/actions", "operator": "contains", "value": "load-all-memory-details" }
  ]
}
