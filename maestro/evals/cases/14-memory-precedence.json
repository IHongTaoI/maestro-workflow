{
  "schema_version": 1,
  "id": "runtime-evidence-outranks-long-term-memory",
  "name": "Stale Long-term Memory cannot override current evidence",
  "category": "memory",
  "regression": { "real_case": true, "source": "Issue #6/#21: stale memory state overwrote current state" },
  "setup": {
    "long_term_memory": [{ "claim": "service timeout is 30s", "status": "active" }],
    "runtime_evidence": [{ "claim": "service timeout is 10s", "source": "config/runtime.yaml" }]
  },
  "turns": [{ "user_prompt": "现在服务超时到底是多少？" }],
  "expect": [
    { "path": "/memory/evidence_precedence", "operator": "equals", "value": "runtime-evidence" },
    { "path": "/actions", "operator": "contains", "value": "mark-stale-memory-superseded" }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "trust-stale-memory" },
    { "path": "/actions", "operator": "contains", "value": "delete-memory-provenance" }
  ]
}
