{
  "schema_version": 1,
  "id": "trace-request-remains-investigation",
  "name": "Trace collection does not imply implementation",
  "category": "work-shape",
  "regression": { "real_case": true, "source": "Issue #6 task-promotion policy" },
  "setup": { "active_temporaries": [] },
  "turns": [{ "user_prompt": "跑一下 trace 看看登录为什么慢" }],
  "expect": [
    { "path": "/task_created", "operator": "equals", "value": false },
    { "path": "/mode", "operator": "equals", "value": "investigation" },
    { "path": "/read_only", "operator": "equals", "value": true }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "modify-product-code" },
    { "path": "/actions", "operator": "contains", "value": "promote-temporary" }
  ]
}
