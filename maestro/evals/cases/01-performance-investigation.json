{
  "schema_version": 1,
  "id": "performance-investigation-stays-temporary",
  "name": "Performance investigation stays read-only and informal",
  "category": "work-shape",
  "regression": { "real_case": true, "source": "Issue #6/#21: investigation was mistaken for a formal workflow" },
  "setup": { "active_temporaries": [] },
  "turns": [{ "user_prompt": "帮我分析一下首页为什么启动慢，先别改代码" }],
  "expect": [
    { "path": "/task_created", "operator": "equals", "value": false },
    { "path": "/implementation_started", "operator": "equals", "value": false },
    { "path": "/mode", "operator": "equals", "value": "investigation" },
    { "path": "/read_only", "operator": "equals", "value": true }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "modify-product-code" },
    { "path": "/actions", "operator": "contains", "value": "create-formal-task-without-execution-intent" }
  ]
}
