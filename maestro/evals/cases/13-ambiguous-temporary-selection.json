{
  "schema_version": 1,
  "id": "ambiguous-temporary-selection-asks-user",
  "name": "Multiple plausible Temporaries are not selected randomly",
  "category": "memory",
  "regression": { "real_case": true, "source": "Issue #5/#21: active Temporary selection was wrong" },
  "setup": {
    "active_temporaries": [
      { "id": "temp-api-v1", "topic": "API latency in v1" },
      { "id": "temp-api-v2", "topic": "API latency in v2" }
    ],
    "session_binding": null
  },
  "turns": [{ "user_prompt": "继续 API 延迟那个问题" }],
  "expect": [
    { "path": "/memory/selected_temporary", "operator": "equals", "value": null },
    { "path": "/user_questions", "operator": "length_equals", "value": 1 }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "select-newest-temporary" },
    { "path": "/actions", "operator": "contains", "value": "merge-temporaries" }
  ]
}
