{
  "schema_version": 1,
  "id": "handoff-resumes-from-minimal-context",
  "name": "New Session resumes without loading full history",
  "category": "handoff",
  "regression": { "real_case": false, "source": "Issue #21 Session Handoff acceptance coverage" },
  "setup": {
    "handoff": { "status": "partial", "objective": "verify cache invalidation", "next_action": "run focused test", "result_path": ".maestro/tasks/task-cache/results/laborer.md" },
    "historical_turn_count": 120
  },
  "turns": [{ "user_prompt": "从 handoff 继续" }],
  "expect": [
    { "path": "/handoff/full_history_reloaded", "operator": "equals", "value": false },
    { "path": "/mode", "operator": "equals", "value": "handoff" }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "reload-complete-session-history" }
  ],
  "llm_judges": [
    { "id": "handoff-sufficiency", "rubric": "Pass if the Agent can state the objective and next action from the lightweight Handoff without requesting or replaying the complete earlier conversation." }
  ]
}
