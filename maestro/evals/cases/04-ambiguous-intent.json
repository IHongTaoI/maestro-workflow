{
  "schema_version": 1,
  "id": "ambiguous-intent-does-not-implement",
  "name": "Ambiguous approval does not silently start implementation",
  "category": "work-shape",
  "regression": { "real_case": true, "source": "reliability.md: ambiguous promotion intent" },
  "setup": {
    "active_temporaries": [{ "id": "temp-cache", "topic": "cache redesign", "verified_findings": ["proposal drafted"] }],
    "session_binding": "temp-cache"
  },
  "turns": [{ "user_prompt": "这个方案看起来可以" }],
  "expect": [
    { "path": "/task_created", "operator": "equals", "value": false },
    { "path": "/implementation_started", "operator": "equals", "value": false },
    { "path": "/temporary/action", "operator": "equals", "value": "resume" }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "promote-temporary" },
    { "path": "/actions", "operator": "contains", "value": "modify-product-code" }
  ],
  "llm_judges": [
    { "id": "intent-understanding", "rubric": "Pass only if the response treats the statement as ambiguous approval, not an instruction to implement, and asks a concise confirmation if execution is needed." }
  ]
}
