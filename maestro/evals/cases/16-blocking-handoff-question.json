{
  "schema_version": 1,
  "id": "blocked-handoff-carries-exact-question",
  "name": "Blocked Handoff contains the exact user question",
  "category": "handoff",
  "regression": { "real_case": true, "source": "Issue #6: Handoff required reopening Detailed Result for the question" },
  "setup": { "task": { "id": "task-bootstrap", "status": "active" } },
  "turns": [{ "user_prompt": "保存当前进度，下一步需要我决定是否调整启动顺序" }],
  "expect": [
    { "path": "/handoff/created", "operator": "equals", "value": true },
    { "path": "/handoff/status", "operator": "equals", "value": "blocked" },
    { "path": "/handoff/needs_user_input", "operator": "equals", "value": true },
    { "path": "/handoff/questions", "operator": "length_equals", "value": 1 }
  ],
  "must_not": [
    { "path": "/actions", "operator": "contains", "value": "write-blocked-handoff-without-question" }
  ]
}
