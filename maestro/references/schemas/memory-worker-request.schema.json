{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/memory-worker-request.schema.json",
  "title": "Maestro Memory Worker Request",
  "type": "object",
  "required": [
    "operation",
    "source_files",
    "current_memory",
    "current_playbooks",
    "memory_hints"
  ],
  "properties": {
    "operation": {
      "enum": ["role-compress", "session-handoff", "task-bootstrap", "task-complete"]
    },
    "source_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "current_memory": {
      "type": "object",
      "required": ["long_term_entries"],
      "properties": {
        "long_term_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/longTermEntry" }
        }
      },
      "additionalProperties": true
    },
    "current_playbooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/playbook" }
    },
    "memory_hints": { "type": "object" },
    "task_context": { "type": "object" },
    "source_content": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "longTermEntry": {
      "type": "object",
      "required": ["entry_id", "title", "memory_kind", "content", "source_refs"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "memory_kind": {
          "enum": ["fact", "experience", "principle", "decision", "constraint", "other"]
        },
        "content": { "type": "string", "minLength": 1 },
        "decision_context": { "$ref": "#/$defs/decisionContext" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "memory_kind": { "not": { "const": "decision" } } },
            "required": ["memory_kind"]
          },
          "then": { "properties": { "decision_context": false } }
        }
      ]
    },
    "decisionContext": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alternative", "reason"],
            "properties": {
              "alternative": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "playbook": {
      "type": "object",
      "required": [
        "playbook_id",
        "file_path",
        "title",
        "trigger",
        "steps",
        "checks",
        "status",
        "revision",
        "updated_at",
        "updated_by",
        "source_refs"
      ],
      "properties": {
        "playbook_id": { "$ref": "#/$defs/stableId" },
        "file_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\.maestro/playbooks/(?!(?:candidates|decisions)(?:/|$)).+\\.(?:md|markdown|yaml|yml)$"
        },
        "title": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status": { "const": "active" },
        "revision": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" },
        "updated_by": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
