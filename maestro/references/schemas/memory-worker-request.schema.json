{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/memory-worker-request.schema.json",
  "title": "Maestro Memory Worker Request",
  "type": "object",
  "required": [
    "operation",
    "source_files",
    "current_memory",
    "current_playbooks",
    "memory_hints"
  ],
  "properties": {
    "operation": {
      "enum": ["role-compress", "session-handoff", "task-bootstrap", "task-complete"]
    },
    "source_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "current_memory": {
      "type": "object",
      "required": ["long_term_entries"],
      "properties": {
        "long_term_entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/longTermEntry" }
        }
      },
      "additionalProperties": true
    },
    "current_playbooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/playbook" }
    },
    "memory_hints": { "type": "object" },
    "task_context": { "type": "object" },
    "source_content": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "longTermEntry": {
      "type": "object",
      "required": ["entry_id", "title", "memory_kind", "content", "source_refs"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "memory_kind": {
          "enum": ["fact", "experience", "principle", "decision", "constraint", "other"]
        },
        "content": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "playbook": {
      "type": "object",
      "required": [
        "playbook_id",
        "title",
        "trigger",
        "steps",
        "status",
        "source_refs"
      ],
      "properties": {
        "playbook_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": { "const": "active" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
