{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/memory-worker-request.schema.json",
  "title": "Maestro Memory Worker Request",
  "type": "object",
  "required": ["operation", "source_files", "current_memory", "memory_hints"],
  "properties": {
    "operation": {
      "enum": ["role-compress", "session-handoff", "task-bootstrap", "task-complete"]
    },
    "source_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "current_memory": { "type": "object" },
    "memory_hints": { "type": "object" },
    "task_context": { "type": "object" },
    "source_content": { "type": "object" }
  },
  "additionalProperties": false
}
