{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/task.schema.json",
  "title": "Maestro Task Metadata",
  "type": "object",
  "required": [
    "id",
    "objective",
    "status",
    "created_at",
    "updated_at",
    "updated_by",
    "revision"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": { "enum": ["preparing", "active", "completed", "cancelled", "archive"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "source_temporary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
