{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/handoff.schema.json",
  "title": "Maestro Role or Worker Handoff",
  "type": "object",
  "required": [
    "status",
    "summary",
    "result_path",
    "needs_user_input",
    "recommended_next"
  ],
  "properties": {
    "status": { "enum": ["completed", "blocked", "failed", "cancelled"] },
    "summary": { "type": "string", "minLength": 1 },
    "result_path": { "type": "string", "minLength": 1 },
    "role_state_path": { "type": "string", "minLength": 1 },
    "worker_state_path": { "type": "string", "minLength": 1 },
    "needs_user_input": { "type": "boolean" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "reason"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "recommended_next": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["role", "reason"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["capabilities", "reason"],
            "properties": {
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        { "required": ["role_state_path"], "not": { "required": ["worker_state_path"] } },
        { "required": ["worker_state_path"], "not": { "required": ["role_state_path"] } }
      ]
    },
    {
      "if": {
        "properties": { "needs_user_input": { "const": true } },
        "required": ["needs_user_input"]
      },
      "then": {
        "required": ["questions"],
        "properties": {
          "status": { "const": "blocked" },
          "questions": { "type": "array", "minItems": 1 }
        }
      },
      "else": {
        "properties": { "questions": { "type": "array", "maxItems": 0 } }
      }
    }
  ],
  "additionalProperties": false
}
