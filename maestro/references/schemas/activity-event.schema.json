{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/activity-event.schema.json",
  "title": "Maestro Activity Event",
  "description": "一条追加到活动时间线的不可变事件。occurred_at 在事件发生时现场生成，不得从文件 mtime 反推。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "event_type",
    "title",
    "summary",
    "source_refs",
    "status"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^activity-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": ["task_completed", "decision_approved"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "const": "completed"
    }
  }
}
