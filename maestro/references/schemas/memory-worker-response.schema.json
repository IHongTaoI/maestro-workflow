{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/memory-worker-response.schema.json",
  "title": "Maestro Memory Worker Response",
  "type": "object",
  "required": ["status", "current"],
  "properties": {
    "status": { "const": "completed" },
    "current": {
      "type": "object",
      "required": ["content"],
      "properties": { "content": { "type": "object" } },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "content", "source_refs"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "discarded": {},
    "long_term_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "content", "source_refs"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {}
  },
  "additionalProperties": false
}
