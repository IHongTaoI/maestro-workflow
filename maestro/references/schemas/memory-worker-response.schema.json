{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.local/schemas/memory-worker-response.schema.json",
  "title": "Maestro Memory Worker Response",
  "type": "object",
  "required": ["status", "current"],
  "properties": {
    "status": { "const": "completed" },
    "current": {
      "type": "object",
      "required": ["content"],
      "properties": { "content": { "type": "object" } },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "discarded": {},
    "long_term_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/longTermCandidate" }
    },
    "notes": {}
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sourceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "reference": {
      "type": "object",
      "required": ["title", "content", "source_refs"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "id", "created_at"],
      "properties": {
        "type": { "enum": ["temporary", "task"] },
        "id": { "$ref": "#/$defs/stableId" },
        "workspace_id": { "$ref": "#/$defs/stableId" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": ["classification", "entry_ids"],
      "properties": {
        "classification": {
          "enum": ["novel", "duplicate", "overlap", "conflict", "low-value"]
        },
        "entry_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "longTermCandidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "title",
        "memory_kind",
        "action",
        "match",
        "conflict_status",
        "content",
        "rationale",
        "source",
        "source_refs"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "memory_kind": {
          "enum": ["fact", "experience", "principle", "decision", "constraint", "other"]
        },
        "action": { "enum": ["UPDATE", "MERGE", "CREATE", "SKIP"] },
        "match": { "$ref": "#/$defs/match" },
        "conflict_status": {
          "enum": ["none", "pending-confirmation", "confirmed"]
        },
        "content": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "CREATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "const": "novel" },
                  "entry_ids": { "type": "array", "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "UPDATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "enum": ["overlap", "conflict"] },
                  "entry_ids": { "type": "array", "minItems": 1, "maxItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "MERGE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "classification": { "enum": ["overlap", "conflict"] },
                  "entry_ids": { "type": "array", "minItems": 2 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "SKIP" } }, "required": ["action"] },
          "then": {
            "properties": {
              "match": {
                "type": "object",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "classification": { "const": "duplicate" },
                      "entry_ids": { "type": "array", "minItems": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "classification": { "const": "low-value" },
                      "entry_ids": { "type": "array", "maxItems": 0 }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "type": "object",
                "properties": { "classification": { "const": "conflict" } },
                "required": ["classification"]
              }
            },
            "required": ["match"]
          },
          "then": {
            "properties": {
              "conflict_status": { "enum": ["pending-confirmation", "confirmed"] }
            }
          },
          "else": {
            "properties": { "conflict_status": { "const": "none" } }
          }
        }
      ]
    }
  }
}
