{
  "name": "@maestro-ai/dsh-adapter",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) adapter for Maestro: registers the portable Maestro Core Skill as a dsh skill and provides deterministic state-protocol helpers on top of ctx.fs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "keywords": [
    "maestro",
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "skill",
    "adapter",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.5.0",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
